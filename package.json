{
  "name": "ahmad-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Ahmad's portfolio — Next.js frontend + Express API in a single project",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"next dev -H 0.0.0.0\" \"nodemon server/server.js\"",
    "dev:web": "next dev -H 0.0.0.0",
    "dev:api": "nodemon server/server.js",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "start:api": "node server/server.js",
    "db:migrate": "node scripts/run-migrations.js",
    "auth:check": "node scripts/check-auth.js",
    "lint": "next lint"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.0.1",
    "@googleapis/drive": "^21.0.0",
    "@react-three/drei": "^9.105.6",
    "@react-three/fiber": "^8.16.6",
    "@supabase/supabase-js": "^2.112.4",
    "backblaze-b2": "^1.7.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "express-validator": "^7.0.1",
    "file-saver": "^2.0.5",
    "framer-motion": "^11.2.6",
    "helmet": "^7.1.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.394.0",
    "morgan": "^1.10.0",
    "next": "^14.2.35",
    "next-auth": "^4.24.15",
    "nodemailer": "^6.9.13",
    "otplib": "^13.5.0",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.164.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3"
  }
}
