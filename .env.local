# ============================================================
# Telegram Cloud Storage (PRIMARY object store - bot here)
# 1) Create a bot via @BotFather -> get TG_BOT_TOKEN
# 2) Create a private channel, add the bot as admin
#    -> get the channel id (negative number, e.g. -100xxxx) as TG_CHANNEL_ID
# Telegram is the PRIMARY store for binaries/text bodies. Backblaze B2 is used
# only as a fallback when Telegram is full or unavailable.
# ============================================================
TG_BOT_TOKEN=8997316971:AAHLAT3TD1DDCSXrrpQrX5Hu-t2EJXCUW1g
TG_CHANNEL_ID=-1004302785086

# Telegram capacity cap (bytes) for tiering: when Telegram's stored footprint
# plus the incoming bytes exceed this, new uploads fall back to Backblaze B2.
# Leave unset to always use Telegram (until it errors).
# TG_MAX_BYTES=5368709120

# B2 capacity cap (bytes): kept for legacy. With Telegram primary, B2 is the
# fallback store, so B2_MAX_BYTES normally stays unset.
# B2_MAX_BYTES=5368709120
NEXTAUTH_URL=http://localhost:3000
